# Ambiente virtuale Python locale
venv/
env/
.env

# Bytecode e cache Python
__pycache__/
*.py[cod]
*$py.class

# File temporanei editor e OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.log
.vscode/

# Script personale di backup sviluppatore
backup.sh


# Database personale (dati sensibili: non versionare MAI)
data/archivio.db
data/archivio.db-wal
data/archivio.db-shm
data/backup/
data/.secret_key
data/.aggiornamento.lock

# Cache ricerche e file di runtime server
data/cache/
data/server.pid
data/server.log
data/*.log
data/*backup*
data/*.bak

# Stato e materiale del sistema di aggiornamento (mai versionare)
data/updates/
data/aggiornamento_stato.json

# Pacchetti di rilascio e aggiornamento
Aggiornamento_*.zip
Aggiornamento_*.tar.gz

# Copertine e foto OCR dell'utente: su un repository pubblico non devono mai finire
static/covers/copertina_*
static/covers/foto_acquisita_*
